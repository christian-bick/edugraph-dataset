{
  "name": "edugraph-content",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run --pool=threads --exclude \"**/*.it.test.ts\"",
    "test:integration": "vitest --run .it.test.ts",
    "test:all": "vitest --run",
    "test:coverage": "vitest run --coverage && npx vite-node src/scripts/check-generator-coverage.ts",
    "check": "vite-node src/scripts/check-all.ts",
    "check:labels": "vite-node src/scripts/check-labels.ts",
    "check:generator-view-specs": "vite-node src/scripts/validate-generator-view-specs.ts",
    "check:standards-spec": "vite-node src/scripts/validate-standards-spec.ts",
    "check:docs": "vite-node src/scripts/validate-docs.ts",
    "check:types": "tsc --noEmit",
    "generate:dataset": "vite-node src/scripts/generate-dataset.ts",
    "generate:dataset:container": "vite-node src/scripts/generate-dataset-container.ts",
    "merge:dataset": "vite-node src/scripts/merge-dataset.ts",
    "validate:dataset": "vite-node src/scripts/validate-dataset.ts",
    "audit:dataset": "vite-node src/scripts/validate-dataset.ts --audit",
    "audit:dataset:report": "vite-node src/scripts/validate-dataset.ts --audit --report-only",
    "test:vqa": "vite-node src/scripts/validate-dataset.ts",
    "report:coverage": "vite-node src/scripts/generate-coverage-report.ts",
    "report:churn": "vite-node src/scripts/report-cache-churn.ts",
    "report:splits": "vite-node src/scripts/report-splits.ts",
    "test:sample": "vite-node src/scripts/test-sample.ts",
    "test:target": "vite-node src/scripts/test-target.ts",
    "show:imp-todos": "vite-node src/scripts/show-implementation-todos.ts",
    "show:ont-todos": "vite-node src/scripts/show-ontology-todos.ts",
    "show:matching": "vite-node src/scripts/show-matching-stats.ts",
    "report:matching-diff": "vite-node src/scripts/report-matching-diff.ts",
    "analyze:target-distinctness": "vite-node src/scripts/analyze-target-distinctness.ts",
    "generate:standards-explorer": "npm run map:standards",
    "map:standards": "vite-node src/scripts/map-standards.ts",
    "validate:coverage": "vite-node src/scripts/validate-coverage.ts",
    "upload:gcs": "vite-node src/scripts/upload-to-gcs.ts",
    "sync:gcs": "vite-node src/scripts/upload-to-gcs.ts --sync",
    "sync:gcs:dry": "vite-node src/scripts/upload-to-gcs.ts --sync --dry",
    "upload:s3": "vite-node src/scripts/upload-to-s3.ts",
    "sync:s3": "vite-node src/scripts/upload-to-s3.ts --sync",
    "sync:s3:dry": "vite-node src/scripts/upload-to-s3.ts --sync --dry"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.525.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@google-cloud/storage": "^7.16.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "glob": "^11.0.3",
    "playwright": "1.60.0",
    "puppeteer": "^24.16.0",
    "sass-embedded": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vite-plugin-handlebars": "^2.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "edugraph-ts": "https://github.com/christian-bick/edugraph-ontology/releases/download/v0.11.0/edugraph-ts.tgz",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  }
}
